# ###########################
# ## Terraform
# ###########################

# Directorios y archivos de Terraform
# Se regeneran automáticamente al ejecutar `terraform init`.
.terraform/
.terraform.lock.hcl
.terraform.lock*
.terraformrc
terraform.rc

# Archivos de estado locales. ¡MUY IMPORTANTE!
# Estos archivos contienen el estado de tu infraestructura y pueden incluir datos sensibles.
# Se recomienda encarecidamente usar un backend remoto (como S3, Azure Blob Storage, etc.).
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform.tfstate*

# Archivos de plan.
# Pueden contener valores de variables y datos sensibles en texto plano.
# Son archivos temporales generados por `terraform plan -out=...`.
*.tfplan
*tfplan
plan.json
plan.out

# Archivos de variables que a menudo contienen secretos o configuraciones específicas del entorno.
# Es una buena práctica tener un archivo de ejemplo (ej: terraform.tfvars.example) en el repositorio,
# pero el archivo real con los valores debe ser ignorado.
*.tfvars
*.tfvars.*
*.tfvars.json
*.tfvars.backup*
*.auto.tfvars
*.auto.tfvars.json
# Excepciones: permitir archivos de ejemplo y por entorno
!*.tfvars.dev
!*.tfvars.qa
!*.tfvars.stg
!*.tfvars.prod
!*.tfvars.example
!**/tfvars.example
!**/*.tfvars.example

# Archivos de log de errores (crash logs).
crash.log
crash.*.log

# Archivos de override.
# Estos se usan para sobreescribir temporalmente configuraciones y no deben ser compartidos.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terragrunt (si se usa)
.terragrunt-cache/
.terragrunt-cache.lock

# ###########################
# ## Credenciales y Secretos
# ###########################

keys/
*.pem
*.key
*.json
# Excepciones: permitir archivos de ejemplo JSON
!**/tfvars.example
!**/*.tfvars.example

# ###########################
# ## Archivos de Sistema Operativo y Editores
# ###########################

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editores de código (ej: VSCode, JetBrains)
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim
*.swp
*.swo
*~

# ###########################
# ## Logs y Archivos Temporales
# ###########################

*.log
*.tmp
scripts/*.log
scripts/*.tmp

# ###########################
# ## Archivos Comprimidos
# ###########################

# Archivos comprimidos que puedan contener builds o artefactos locales
*.zip
*.tar
*.gz

# ###########################
# ## Archivos de Configuración y Entorno
# ###########################

# Archivo de configuración del proyecto
.env

# Archivos de entorno de microservicios (contienen secretos)
**/envs/*.env
!**/envs/*.env.example

# Archivos de versión generados (ej: example-app/version)
version
VERSION
!VERSION.example
