# ============================================================================
# Configuración del Proyecto Terraform GCP
# ============================================================================
# Copia este archivo a .env y edita con tus valores
# cp .env.example .env

# ============================================================================
# Variables Obligatorias
# ============================================================================

# ID del proyecto GCP donde se desplegará la infraestructura
PROJECT_ID="mi-proyecto-dev-123456"

# Nombre del workspace (ej: platform, analytics, etc.)
WORKSPACE="platform"

# ID de la organización de GCP (requerido para VPC Service Controls)
ORGANIZATION_ID="123456789012"

# Dominios permitidos para miembros IAM (separados por comas)
ALLOWED_DOMAINS="miempresa.com,subdominio.miempresa.com"

# Nombre del Artifact Registry (repositorio Docker)
REGISTRY_NAME="docker-images-dev"

# Prefijo para buckets de estado de Terraform
# El nombre final será: ${BUCKET_PREFIX}-${env}
BUCKET_PREFIX="mi-proyecto-terraform-state"

# ============================================================================
# Variables Opcionales
# ============================================================================

# Región de GCP (default: us-central1)
REGION="us-central1"

# Ambiente (dev, stg, prod) - se puede sobrescribir por ambiente
ENV="dev"

# ============================================================================
# Grupos de Administradores (Opcional pero Recomendado)
# ============================================================================
# Si defines estos valores, el script los configurará automáticamente
# Si no los defines, deberás configurarlos manualmente en terraform.tfvars

NETWORK_ADMINS="network-admins@miempresa.com"
NETWORK_VIEWERS="developers@miempresa.com"
SECURITY_ADMINS="security-admins@miempresa.com"
AUDITORS="auditors@miempresa.com"

# ============================================================================
# Notas
# ============================================================================
# - El archivo .env está en .gitignore y no se subirá al repositorio
# - Después de ejecutar 'make setup', revisa los archivos modificados
# - Si no defines los grupos de administradores aquí, configúralos manualmente
#   en terraform.tfvars después de ejecutar el script
