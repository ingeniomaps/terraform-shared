# ============================================================================
# CONFIGURACIÓN PARA AMBIENTE: DEVELOPMENT
# ============================================================================

# ============================================================================
# CONFIGURACIÓN DEL PROYECTO
# ============================================================================
project_id  = "tu-proyecto-dev-123456"
region      = "us-central1"
zone        = "us-central1-a"

# Opcional: Nombre del archivo JSON de credenciales (debe estar en ../keys/)
# Si no se especifica, se usa GOOGLE_APPLICATION_CREDENTIALS o gcloud auth
# credentials_file = "account_service_dev.json"

# ============================================================================
# ESTADO DE LA INFRAESTRUCTURA COMPARTIDA
# ============================================================================
# Bucket donde está el estado de shared-infra
shared_infra_state_bucket = "terraform-state-dev"

# Prefijo del estado (debe coincidir con el backend de shared-infra)
shared_infra_state_prefix = "shared/terraform"

# ============================================================================
# CONFIGURACIÓN DE LA VM
# ============================================================================
instance_name = "vm-artifact-dev"
machine_type  = "e2-medium"

# Disco
boot_disk_size = 20
boot_disk_type = "pd-standard"

# Red
enable_public_ip = true  # Habilitar IP pública para acceso directo

# IP estática pública (requerida para acceso por puerto 80)
static_public_ip = "vm-artifact-dev-static-ip"  # Nombre del recurso de IP estática

# Opcional: IP interna estática (debe estar en el rango de la subnet)
# static_internal_ip = "10.0.0.10"  # IP del rango de vm_subnet_cidr

# Tags y Labels
# Tag "allow-iap-ssh" es necesario para permitir SSH vía IAP
# Tag "allow-http-direct" es necesario para acceso HTTP directo (si enable_public_ip = true)
tags = ["allow-iap-ssh", "allow-http-direct"]
labels = {
  environment = "dev"
  team        = "mi-equipo"
}

# ============================================================================
# CONFIGURACIÓN DE DOCKER Y ARTIFACT REGISTRY
# ============================================================================
# Imagen Docker a ejecutar (formato: nombre-imagen:tag)
# La imagen debe estar en el Artifact Registry configurado en shared-infra
#
# OPCIONES:
# - Usar última versión: "hello-world:latest" (se actualiza automáticamente)
# - Usar versión específica: "hello-world:1.2.3" (fija, para rollback/testing)
#
# Para cambiar la versión sin editar este archivo:
#   terraform apply -var="docker_image=hello-world:1.0.5"
#
docker_image = "hello-world:latest"

# Puertos
# Puerto 80 para acceso HTTP público (sin SSL)
container_port = 80   # Puerto interno del contenedor (nginx expone 80)
host_port      = 80   # Puerto del host (acceso público por HTTP)

# Variables de entorno para el contenedor
docker_env_vars = {
  ENV          = "development"
  LOG_LEVEL     = "debug"
  DATABASE_URL = "postgresql://user:pass@db-dev.internal:5432/dbname"
}

# Opcional: Comando personalizado para ejecutar el contenedor
# docker_command = ""

# Política de reinicio (always, unless-stopped, on-failure, no)
restart_policy = "always"

# Usar imagen Ubuntu (recomendado para desarrollo, permite más control)
# Si es false, usa Container-Optimized OS (más seguro pero menos flexible)
use_ubuntu_image = true

# Familia de imagen Ubuntu (opcional, default: "ubuntu-2204-lts")
# Solo aplica si use_ubuntu_image = true
# ubuntu_image_family = "ubuntu-2204-lts"

# ============================================================================
# HEALTH CHECKS
# ============================================================================
# Opcional: Ruta para health check HTTP
# health_check_path = "/health"

# Opcional: Puerto para health check (usa container_port si es 0)
# health_check_port = 8080
