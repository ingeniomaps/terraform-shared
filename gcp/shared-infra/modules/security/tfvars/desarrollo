# ============================================================================
# EJEMPLO DE CONFIGURACIÓN PARA DESARROLLO
# ============================================================================

# Configuración del proyecto
project_id = "mi-proyecto-dev-123456"
workspace  = "platform"
env        = "dev"

# Artifact Registry
registry_name     = "docker-images-dev"
registry_location = "us-central1"

# Organización
organization_id = "123456789012"

# Dominios permitidos
allowed_domains = [
  "miempresa.com"
]

# Grupos de administradores (usar grupos de Google Workspace/Cloud Identity)
admin_groups = {
  network_admins  = "network-admins-dev@miempresa.com"
  network_viewers = "developers@miempresa.com"
  security_admins = "security-admins-dev@miempresa.com"
  auditors        = "auditors@miempresa.com"
}

# Habilitar cuenta de desarrolladores (deshabilitado en prod)
enable_dev_reader = true

# VPC Service Controls (OBLIGATORIO en producción)
enable_vpc_service_controls = false

# Canales de notificación para alertas
# Primero crear los canales en GCP Console o vía Terraform
alert_notification_channels = [
  "projects/mi-proyecto-dev-123456/notificationChannels/1234567890"
]

# Duración máxima de sesión para break-glass (2 horas)
break_glass_max_session_duration = 7200