# security
project_id  = ""
workspace   = ""
region      = "us-central1"
env         = "stg"

registry_name     = "docker-images-stg"
enable_dev_reader = false

enable_vpc_service_controls = false
break_glass_max_session_duration = 7200

organization_id = ""

allowed_domains = [
    "miempresa.com"
]

admin_groups = {
  network_admins  = "network-admins@miempresa.com"
  network_viewers = "developers@miempresa.com"
  security_admins = "security-admins@miempresa.com"
  auditors        = "auditors@miempresa.com"
}

alert_notification_channels = [
  "projects/xxx/notificationChannels/yyy"
]

## Para desarrollo
# project_id  = "mi-proyecto-dev-123456"
# workspace   = "platform"
# env         = "dev"
# registry_name     = "docker-images-dev"
# registry_location = "us-central1"
# enable_dev_reader = true
# enable_vpc_service_controls = false
# break_glass_max_session_duration = 7200

## Para produccion
# project_id  = "mi-proyecto-prod-123456"
# workspace   = "platform"
# env         = "prod"
# registry_name     = "docker-images-prod"
# registry_location = "us-central1"
# enable_dev_reader = false
# enable_vpc_service_controls = true
# break_glass_max_session_duration = 3600


### Para network

# ============================================================================
# CONFIGURACIÓN PARA PRODUCCIÓN (sin GKE, acceso público)
# ============================================================================
# Subnet para VMs tradicionales
vm_subnet_cidr = "10.0.0.0/24" # 256 IPs

# Acceso HTTP/HTTPS público (para load balancers)
enable_public_http     = true
enable_restricted_http = false

# GKE deshabilitado en este ejemplo
enable_gke = false

# VPC Peering deshabilitado
enable_vpc_peering = false


# ============================================================================
# CONFIGURACIÓN PARA PRODUCCIÓN CON GKE
# ============================================================================
# # Subnets separadas para VMs y GKE
# vm_subnet_cidr = "10.0.0.0/24"    # 256 IPs para VMs
#
# # GKE habilitado
# enable_gke = true
#
# # IMPORTANTE: Estos rangos NO deben solaparse
# gke_subnet_cidr    = "10.0.10.0/24"  # 256 IPs para nodes
# gke_pods_cidr      = "10.1.0.0/16"   # 65k pods
# gke_services_cidr  = "10.2.0.0/16"   # 65k services
# gke_master_cidr    = "172.16.0.0/28" # Control plane (16 IPs)
#
# # Acceso público (para ingress/load balancer)
# enable_public_http     = true
# enable_restricted_http = false
#
# enable_vpc_peering = false


# ============================================================================
# CONFIGURACIÓN PARA DESARROLLO (acceso restringido)
# ============================================================================
# vm_subnet_cidr = "10.0.0.0/24"
#
# # Acceso HTTP/HTTPS solo desde oficina/VPN
# enable_public_http     = false
# enable_restricted_http = true
# corporate_ip_ranges = [
#   "203.0.113.0/24",  # Oficina principal
#   "198.51.100.0/24"  # VPN corporativa
# ]
#
# enable_gke = false
# enable_vpc_peering = false


# ============================================================================
# CONFIGURACIÓN CON VPC PEERING (multi-proyecto)
# ============================================================================
# vm_subnet_cidr = "10.0.0.0/24"
#
# enable_public_http     = true
# enable_restricted_http = false
#
# # VPC Peering hacia otro proyecto
# enable_vpc_peering = true
# peer_project_id    = "mi-proyecto-b-789012"
# peer_vpc_name      = "shared-services-vpc"
#
# enable_gke = false


# ============================================================================
# CONFIGURACIÓN COMPLETA: PROD CON GKE + VPC PEERING
# ============================================================================
# # Subnets
# vm_subnet_cidr = "10.0.0.0/24"
#
# # GKE con rangos bien separados
# enable_gke         = true
# gke_subnet_cidr    = "10.0.10.0/24"
# gke_pods_cidr      = "10.1.0.0/16"
# gke_services_cidr  = "10.2.0.0/16"
# gke_master_cidr    = "172.16.0.0/28"
#
# # Acceso público
