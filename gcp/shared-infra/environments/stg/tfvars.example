# PLANTILLA — copiar a terraform.tfvars y ajustar (ver Makefile: make init/plan/apply)
# ============================================================================
# CONFIGURACION DEL PROYECTO - STG
# ============================================================================
project_id = "YOUR_GCP_PROJECT_ID"
workspace  = "my-workspace"
region     = "us-central1"
env        = "stg"

# Opcional: ruta al JSON de credenciales (relativa a la raiz del proyecto).
# Si no se especifica, se usa GOOGLE_APPLICATION_CREDENTIALS o gcloud auth.
# credentials_file = "keys/account_service_dev.json"

# ============================================================================
# ARTIFACT REGISTRY
# ============================================================================
registry_name            = "my-registry"
enable_dev_reader        = true

# ============================================================================
# SEGURIDAD
# ============================================================================
break_glass_max_session_duration = 7200
# ============================================================================
# RED Y CONECTIVIDAD
# ============================================================================
vm_subnet_cidr         = "10.0.0.0/24"
enable_public_http     = true
enable_restricted_http = false
enable_vpc_peering     = false

# ============================================================================
# GKE (KUBERNETES) - deshabilitado; true cuando se migre a GKE
# ============================================================================
enable_gke        = false
gke_subnet_cidr   = "10.0.10.0/24"
gke_pods_cidr     = "10.1.0.0/16"
gke_services_cidr = "10.2.0.0/16"
gke_master_cidr   = "172.16.0.0/28"

# ============================================================================
# IAM Y GRUPOS  (VERIFICAR contra el Workspace real del proyecto consumidor antes de aplicar)
# ============================================================================
admin_groups = {
  network_admins  = "network-admins@example.com"
  network_viewers = "developers@example.com"
  security_admins = "security-admins@example.com"
  auditors        = "auditors@example.com"
}


# ============================================================================
# ALERTAS Y MONITOREO
# ============================================================================
alert_notification_channels = []

# ============================================================================
# RECURSOS PROJECT-LEVEL - gestionados por bootstrap/global
# ============================================================================
create_vm_start_stop_role = false
create_audit_configs      = false
enable_oslogin_metadata   = false
